{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "timezone": "Europe/Berlin",
    "schedule": [
        "before 7am on Monday"
    ],
    "prConcurrentLimit": 5,
    "labels": [
        "dependencies"
    ],
    "packageRules": [
        {
            "description": "Label GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "ci"
            ]
        }
    ]
}
