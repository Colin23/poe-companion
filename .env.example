### Local development database configuration
### These values are examples only and must not be reused for a hosted deployment.
# Database Configuration
POE_COMPANION_DB_USER=postgres
POE_COMPANION_DB_PASSWORD=
POE_COMPANION_DB_HOST=localhost
POE_COMPANION_DB_PORT=5432
POE_COMPANION_DB_NAME=poe_companion_db

# Local application access
POE_COMPANION_APP_USERNAME=poe-companion
POE_COMPANION_APP_PASSWORD=

# Local development uses HTTP. Hosted HTTPS deployments should omit this
# variable or set it to true.
POE_COMPANION_SECURE_COOKIES=false
