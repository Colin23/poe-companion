{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'config:best-practices',
        ':enableVulnerabilityAlerts',
    ],
    timezone: 'Europe/Berlin',
    schedule: [
        '* 4-8 * * 1',
    ],
    dependencyDashboard: {
        enabled: true,
        title: 'Renovate Dependency Dashboard',
    },
    prConcurrentLimit: 5,
    prHourlyLimit: 2,
    platformCommit: 'enabled',
    platformAutomerge: true,
    automergeType: 'pr',
    automergeStrategy: 'squash',
    rebaseWhen: 'behind-base-branch',
    separateMinorPatch: true,
    ignoreTests: false,
    labels: [
        'dependencies',
    ],
    vulnerabilityAlerts: {
        enabled: true,
        labels: [
            'dependencies',
            'security',
        ],
        prCreation: 'immediate',
        vulnerabilityFixStrategy: 'lowest',
        prConcurrentLimit: 5,
        automerge: false,
    },
    packageRules: [
        {
            description: 'Label GitHub Actions updates',
            matchManagers: [
                'github-actions',
            ],
            addLabels: [
                'ci',
            ],
        },
        {
            description: 'Automerge immutable SHA/digest pinning after CI',
            matchUpdateTypes: [
                'pinDigest',
            ],
            automerge: true,
        },
        {
            description: 'Automerge stable patch updates after a 14-day supply-chain cooldown',
            matchUpdateTypes: [
                'patch',
            ],
            matchCurrentVersion: '!/^0/',
            minimumReleaseAge: '14 days',
            automerge: true,
        },
        {
            description: 'Never automerge pre-1.0 dependencies',
            matchCurrentVersion: '/^0\\./',
            automerge: false,
        },
        {
            description: 'Never automerge prerelease dependencies',
            matchCurrentVersion: '/-/',
            automerge: false,
        },
        {
            description: 'Require manual review for Gradle plugin updates',
            matchManagers: [
                'gradle',
            ],
            matchDepTypes: [
                'plugin',
            ],
            automerge: false,
        },
        {
            description: 'Require manual review when an existing immutable digest or SHA moves',
            matchUpdateTypes: [
                'digest',
            ],
            addLabels: [
                'security',
            ],
            automerge: false,
        },
        {
            description: 'Group Kotlin Gradle plugins',
            matchManagers: [
                'gradle',
            ],
            matchPackageNames: [
                'org.jetbrains.kotlin.jvm',
                'org.jetbrains.kotlin.plugin.jpa',
                'org.jetbrains.kotlin.plugin.spring',
            ],
            groupName: 'Kotlin Gradle plugins',
        },
    ],
}
