{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        ":enableVulnerabilityAlerts"
    ],

    // Interpret schedules in your timezone.
    "timezone": "Europe/Berlin",

    // Routine dependency work happens Monday morning.
    // Vulnerability-alert PRs bypass this schedule.
    "schedule": [
        "* 4-8 * * 1"
    ],

    // Central visibility/control surface for pending updates.
    "dependencyDashboard": true,
    "dependencyDashboardTitle": "Renovate Dependency Dashboard",

    // Keep routine update volume bounded. Vulnerability fixes have their own
    // separate concurrency budget below and always skip the hourly limit.
    "prConcurrentLimit": 5,
    "prHourlyLimit": 2,

    // Let GitHub perform the final merge only after repository rulesets pass.
    "platformAutomerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash",
    "rebaseWhen": "behind-base-branch",
    "separateMinorPatch": true,
    "ignoreTests": false,

    "labels": [
        "dependencies"
    ],

    // GitHub vulnerability alerts -> immediate Renovate security PRs.
    // Keep these manual for now even when CI passes: a security fix can involve
    // a larger-than-patch upgrade and deserves an explicit review.
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": [
            "dependencies",
            "security"
        ],
        "prCreation": "immediate",
        "vulnerabilityFixStrategy": "lowest",
        "prConcurrentLimit": 5,
        "automerge": false
    },

    "packageRules": [
        {
            "description": "Label GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "ci"
            ]
        },
        {
            "description": "Automerge immutable SHA/digest pinning after CI",
            "matchUpdateTypes": [
                "pinDigest"
            ],
            "automerge": true
        },
        {
            "description": "Automerge stable patch updates after a 14-day supply-chain cooldown",
            "matchUpdateTypes": [
                "patch"
            ],
            "matchCurrentVersion": "!/^0/",
            "minimumReleaseAge": "14 days",
            "automerge": true
        },
        {
            "description": "Never automerge pre-1.0 dependencies",
            "matchCurrentVersion": "/^0\\./",
            "automerge": false
        },
        {
            "description": "Never automerge prerelease dependencies",
            "matchCurrentVersion": "/-/",
            "automerge": false
        },
        {
            "description": "Require manual review when an existing immutable digest or SHA moves",
            "matchUpdateTypes": [
                "digest"
            ],
            "addLabels": [
                "security"
            ],
            "automerge": false
        }
    ]
}
